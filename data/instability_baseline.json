 "meta": {
  "confidence_note": "Country scores carry a confidence tag: high (multiple corroborating sources), medium (partial data), low (estimated from regional patterns). All scores should be treated as modeling inputs with uncertainty, not facts.",
  "indicators": {
   "economic_stress": {
    "description": "Economic pressure: inflation, unemployment, currency instability, debt stress.",
    "sources": "World Bank/IMF inflation and unemployment data 2024-2025, currency performance, public debt context."
   },
   "food_stress": {
    "description": "Food insecurity / affordability pressure. Higher = worse.",
    "sources": "FAO prevalence of undernourishment, Global Hunger Index 2024, World Bank food price inflation. Scores are approximate tiers."
   },
   "gov_trust_deficit": {
    "description": "Lack of public trust in government. Higher = less trust = more instability risk.",
    "sources": "Edelman Trust Barometer, Gallup confidence in government, Asian/Afro/Latinobarometer surveys, World Bank governance context. Note: some authoritarian states (e.g. China) score LOW deficit due to high reported government trust."
   },
   "social_trust_deficit": {
    "description": "Lack of interpersonal/social trust. Higher = less trust between citizens.",
    "sources": "World Values Survey wave 7 ('most people can be trusted'), regional barometers. Higher deficit = more fragmented society."
   }
  },
  "methodology": "Structural baseline for the OSTARA instability index. All scores 0-100, higher = more stress/instability. These are slow-moving structural indicators compiled from public sources (see sources per indicator). They are ESTIMATES for modeling, not precise measurements. Live media signals are layered on top at query time.",
  "updated": "2026-11-03",
  "version": "1.0"
 }
