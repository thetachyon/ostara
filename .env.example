# ostara configuration — copy to .env and fill in what you have.
# NEVER commit a populated .env — only this .env.example belongs in version control.
#
# Every key is optional. Keyed feeds degrade gracefully when unset: they fall
# back to a keyless alternative where one exists, or answer 503 with
# {"error","detail"} (like OSIRIS's own disabled RECON backend). A missing
# key never panics and never breaks other feeds. Empty strings count as unset.

# --- Keyed feeds (env names mirror OSIRIS's own conventions) ----------------

# NASA FIRMS wildfire API: https://firms.modaps.eosdis.nasa.gov/api/
# Required for /api/fires — there is no keyless fallback, so the route
# answers 503 while this is unset.
FIRMS_API_KEY=

# OpenSky Network OAuth2: https://opensky-network.org/
# Preferred aviation source when both are set; falls back to adsb.lol (keyless).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO satellite API: https://www.n2yo.com/api/
# Satellite catalog when set; falls back to CelesTrak TLE (keyless).
N2YO_API_KEY=

# AIS vessel tracking API key (e.g. https://aisstream.io).
# Unset -> /api/vessels answers 503 with {"error","detail"}.
AIS_API_KEY=

# ThreatFox Auth-Key (abuse.ch threat-intel platform): free at https://auth.abuse.ch
# Required for /api/threatfox and the ThreatFox half of /api/cyber/threats.
# Verified 2026-11-01: the Community API REJECTS keyless requests with HTTP 401
# {"error":"Unauthorized"} — there is no keyless tier. Unset -> both routes
# degrade gracefully (503 for /api/threatfox; URLhaus-only for /api/cyber/threats).
THREATFOX_API_KEY=

# --- Telegram OSINT layer (keyless: t.me/s public previews) ------------------
# Comma-separated public channel names (no @). Empty = any public channel via
# ?channel=; non-empty = requests validated against this allowlist.
TELEGRAM_CHANNELS=

# --- RECON enrichment keys (optional; keyless fallbacks exist) --------------
# NVD API key: https://nvd.nist.gov/developers/request-an-api-key
# Raises CVE rate limits; /api/recon/cve works without it.
NVD_API_KEY=

# ipinfo.io token — richer IP/ASN enrichment; falls back to ip-api.com (keyless).
IPINFO_TOKEN=

# --- Active RECON gating ----------------------------------------------------
# Port scanning answers 503 unless explicitly enabled. OSIRIS delegates active
# scanning to a separate backend; we gate it in-process instead.
# RESPONSIBLE USE: only scan infrastructure you own or have written
# authorization to test.
RECON_ENABLED=false
PORT_SCAN_MAX_CONCURRENCY=64
PORT_SCAN_TIMEOUT_MS=1500
PORT_SCAN_MAX_PORTS=1000

# --- Authenticated ingest (reserved for a future endpoint) ------------------
# Fails closed: while unset, authenticated ingestion is disabled.
SDK_INGEST_KEY=

# --- Server -----------------------------------------------------------------
# Mirrors OSIRIS's OSIRIS_PORT convention; the container/app listens on 3000
# internally by default.
OSIRIS_PORT=3000
